# Maintainer: Moins Technologies Inc. <https://github.com/Moins-Technologies-Inc>

pkgname=ouro-terminal-picker
pkgver=0.1.1
pkgrel=1
pkgdesc="Zellij session picker that runs when a terminal opens (OurioPicker)"
arch=('x86_64')
url="https://github.com/Moins-Technologies-Inc/OurioPicker"
license=('MIT')
depends=('gcc-libs' 'glibc')
optdepends=(
  'zellij: sessions to pick from'
  'kitty: terminal wiring'
  'rio: terminal wiring'
)
makedepends=('cargo' 'clang' 'mold')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/Moins-Technologies-Inc/OurioPicker/archive/v${pkgver}.tar.gz")
sha512sums=('97f202ddffd68aece0b3da11686b30cde5054ccf7d26b34bb148f4994890d080ad8ef526533861ca2cc12d9707ddedb69a234367f617538ce52f5774989bc83e') # updated on v0.1.1 tag
options=('!lto')

# The source tree selects Rust 1.100.0 (rust-toolchain.toml) and links with
# clang (.cargo/config.toml). Its mold link flag lives in target rustflags, which
# a RUSTFLAGS from makepkg.conf replaces; mold is then unused but stays listed
# for builds without RUSTFLAGS. RUSTUP_TOOLCHAIN is unset so the pin applies.

prepare() {
  unset RUSTUP_TOOLCHAIN
  cd "OurioPicker-${pkgver}"
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  unset RUSTUP_TOOLCHAIN
  export CARGO_TARGET_DIR=target
  cd "OurioPicker-${pkgver}"
  cargo build --frozen --release --bin ouro-terminal-picker
  mkdir -p target/completions
  ./target/release/ouro-terminal-picker completions bash > target/completions/ouro-terminal-picker.bash
  ./target/release/ouro-terminal-picker completions fish > target/completions/ouro-terminal-picker.fish
  ./target/release/ouro-terminal-picker completions zsh  > target/completions/_ouro-terminal-picker
}

check() {
  # Library tests only: the PTY and Kitty integration suites need python3 and kitty.
  unset RUSTUP_TOOLCHAIN
  export CARGO_TARGET_DIR=target
  cd "OurioPicker-${pkgver}"
  cargo test --frozen --lib
}

package() {
  cd "OurioPicker-${pkgver}"
  install -Dm755 target/release/ouro-terminal-picker -t "${pkgdir}/usr/bin"
  install -Dm644 packaging/desktop/ouro-terminal-picker.desktop \
    "${pkgdir}/usr/share/applications/ouro-terminal-picker.desktop"
  install -Dm644 packaging/icons/ouro-terminal-picker.png \
    "${pkgdir}/usr/share/pixmaps/ouro-terminal-picker.png"
  install -Dm644 packaging/icons/ouro-terminal-picker-dark.png \
    "${pkgdir}/usr/share/pixmaps/ouro-terminal-picker-dark.png"
  install -Dm644 target/completions/ouro-terminal-picker.bash \
    "${pkgdir}/usr/share/bash-completion/completions/ouro-terminal-picker"
  install -Dm644 target/completions/ouro-terminal-picker.fish \
    "${pkgdir}/usr/share/fish/vendor_completions.d/ouro-terminal-picker.fish"
  install -Dm644 target/completions/_ouro-terminal-picker \
    "${pkgdir}/usr/share/zsh/site-functions/_ouro-terminal-picker"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 docs/wiki/terminal-wiring.md "${pkgdir}/usr/share/doc/${pkgname}/terminal-wiring.md"
  install -Dm644 docs/wiki/shell-completions.md "${pkgdir}/usr/share/doc/${pkgname}/shell-completions.md"
  install -Dm644 docs/wiki/zellij-session-list.md "${pkgdir}/usr/share/doc/${pkgname}/zellij-session-list.md"
  install -Dm644 docs/wiki/aur-packaging.md "${pkgdir}/usr/share/doc/${pkgname}/aur-packaging.md"
}
