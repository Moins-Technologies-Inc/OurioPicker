# Maintainer: Moins Technologies Inc. <https://github.com/Moins-Technologies-Inc>

pkgname=ouro-terminal-picker
pkgver=0.1.0
pkgrel=2
pkgdesc="Zellij session picker that runs when a terminal opens (OurioPicker)"
arch=('x86_64')
url="https://github.com/Moins-Technologies-Inc/OurioPicker"
license=('MIT')
# Once the owner-approved transparent PNG icon is bundled under
# /usr/share/icons/hicolor/, add 'hicolor-icon-theme' to depends.
depends=('gcc-libs' 'glibc')
optdepends=(
  'zellij: sessions to pick from'
  'kitty: terminal wiring'
  'rio: terminal wiring'
)
makedepends=('cargo' 'clang' 'mold')

# Existing v0.1.0 tag is immutable and does not contain packaging/desktop/.
# Until a new source release tag bundles the desktop entry, approved icon, and
# clap_complete shell completions, pin the immutable raw commit URL for the
# desktop file with a real sha512sum (never SKIP). Re-pin to the merged main
# commit (or switch to the new release tag tarball) before uploading to AUR.
_desktop_commit=f52adb7507e76a7bf7d8ac40e8d1f304c420eb44
source=(
  "${pkgname}-${pkgver}.tar.gz::https://github.com/Moins-Technologies-Inc/OurioPicker/archive/v${pkgver}.tar.gz"
  "${pkgname}-${pkgver}-${pkgrel}.desktop::https://raw.githubusercontent.com/Moins-Technologies-Inc/OurioPicker/${_desktop_commit}/packaging/desktop/ouro-terminal-picker.desktop"
)
sha512sums=(
  'eb6ea8a04fc7a37c51d5e79d0f6b268d316c197185c345c0158263369d2a9bf38c360d16160a68bd2d7e75f8548d8e0180c130c7c0262aed8de1c540661b6721'
  'd6aff7379159a887e04a137365882c10cc4ca01d5e9d3e8e98eb4217764074098061bf3bf22b7d9a1e97b447fa41deea63eab7c4f36fea751db73badf3b6458f'
)
options=('!lto')

# The source tree selects Rust 1.100.0 (rust-toolchain.toml) and links with
# clang (.cargo/config.toml). Its mold link flag lives in target rustflags, which
# a RUSTFLAGS from makepkg.conf replaces; mold is then unused but stays listed
# for builds without RUSTFLAGS. RUSTUP_TOOLCHAIN is unset so the pin applies.

prepare() {
  # BLOCKED (OurioPicker#5): Do not build or publish this AUR package yet.
  # 1. Icon asset: awaiting an owner-approved transparent PNG icon for
  #    ouro-terminal-picker (or explicit owner authorization for a generic
  #    icon theme fallback). Do not bundle opaque or synthetic icon assets.
  #    When approved, add the icon source + sha512sum (or cut a new release
  #    tag), add 'hicolor-icon-theme' to depends, and install the icon to:
  #      "${pkgdir}/usr/share/icons/hicolor/<size>x<size>/apps/ouro-terminal-picker.png"
  # 2. Shell completions (clap_complete): pending parallel implementation.
  #    Once merged into a new release tag (recommended: v0.1.1 or v0.2.0),
  #    generate completions in build() from the freshly built binary in
  #    target/release/ouro-terminal-picker (never from a host-installed binary)
  #    or Cargo build output, and install them in package() to:
  #      "${pkgdir}/usr/share/bash-completion/completions/ouro-terminal-picker"
  #      "${pkgdir}/usr/share/fish/vendor_completions.d/ouro-terminal-picker.fish"
  #      "${pkgdir}/usr/share/zsh/site-functions/_ouro-terminal-picker"
  # Remove this guard once both items are resolved and regenerate .SRCINFO.
  echo "ERROR: AUR package build is blocked pending an owner-approved transparent PNG icon and clap_complete shell completions (OurioPicker#5)." >&2
  return 1

  unset RUSTUP_TOOLCHAIN
  cd "OurioPicker-${pkgver}"
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  unset RUSTUP_TOOLCHAIN
  export CARGO_TARGET_DIR=target
  cd "OurioPicker-${pkgver}"
  cargo build --frozen --release --bin ouro-terminal-picker
}

check() {
  # Library tests only: the PTY and Kitty integration suites need python3 and kitty.
  unset RUSTUP_TOOLCHAIN
  export CARGO_TARGET_DIR=target
  cd "OurioPicker-${pkgver}"
  cargo test --frozen --lib
}

package() {
  cd "OurioPicker-${pkgver}"
  install -Dm755 target/release/ouro-terminal-picker -t "${pkgdir}/usr/bin"
  install -Dm644 "${srcdir}/${pkgname}-${pkgver}-${pkgrel}.desktop" \
    "${pkgdir}/usr/share/applications/ouro-terminal-picker.desktop"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 docs/wiki/terminal-wiring.md "${pkgdir}/usr/share/doc/${pkgname}/terminal-wiring.md"
}
